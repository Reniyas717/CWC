{
  "name": "@cloud-without-clouds/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "test:auth": "node test-auth.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:phase4": "node test-phase4.js",
    "test:phase5": "node test-phase5.js",
    "test:phase6": "node test-phase6.js",
    "test:worker-network": "node test-worker-network.js",
    "test:task-claim": "node test-task-claim.js",
    "test:result-ownership": "node test-result-ownership.js",
    "test:cancellation-ack": "node test-cancellation-ack.js",
    "test:runtime-failure-cleanup": "node test-runtime-failure-cleanup.js",
    "test:heartbeat-reconciliation": "node test-heartbeat-reconciliation.js",
    "test:worker-recovery": "node test-worker-recovery.js",
    "test:finops": "node test-finops.js",
    "test:all": "node test-auth.js && node test-phase4.js && node test-phase5.js && node test-phase6.js && node test-worker-network.js && node test-task-claim.js && node test-result-ownership.js && node test-cancellation-ack.js && node test-runtime-failure-cleanup.js && node test-heartbeat-reconciliation.js && node test-worker-recovery.js"
  },
  "dependencies": {
    "@cloud-without-clouds/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
