[Unit]
Description=Cloud without Clouds gateway service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudwithoutclouds
WorkingDirectory=/opt/cloud-without-clouds
EnvironmentFile=/etc/cloud-without-clouds/gateway.env
# gateway.env must define GATEWAY_TOKEN and GATEWAY_BIND_HOST=<current Tailscale IPv4>
ExecStart=/usr/bin/node /opt/cloud-without-clouds/deploy/gateway/gateway.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
