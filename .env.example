# ==============================================================================
# Cloud Without Clouds - Environment Configuration Template
# Copy this file to .env before starting the services
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=cwc_user
POSTGRES_PASSWORD=cwc_password
POSTGRES_DB=cloud_without_clouds
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cwc_user:cwc_password@localhost:5432/cloud_without_clouds?schema=public

# Cache & Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API (Control Plane)
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ADMIN_TOKEN=dev-admin-token-change-in-production
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
PUBLIC_API_URL=http://localhost:4000
WORKER_SECRET_TOKEN=dev-worker-secret-token-change-in-production

# Gateway & Ingress (Caddy / Quick Tunnel)
GATEWAY_PORT=5050
GATEWAY_URL=http://localhost:5050
GATEWAY_TOKEN=dev-gateway-secret-token-change-in-production
GATEWAY_BIND_HOST=127.0.0.1

# Frontend (Web Dashboard)
VITE_API_URL=http://localhost:4000
VITE_ADMIN_TOKEN=dev-admin-token-change-in-production

# Worker Node Agent
WORKER_ID=worker-node-local-01
WORKER_NAME="Local Development Worker"
WORKER_PORT=5001
# Optional override; otherwise the worker discovers a 100.64.0.0/10 Tailscale IPv4 interface.
TAILSCALE_IP=
CONTROL_PLANE_URL=http://localhost:4000
MAX_CONCURRENT_WORKLOADS=4
TOTAL_MEMORY_LIMIT_MB=4096
